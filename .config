# ============================================================
# FanchmWrt 编译配置  |  目标: armsr / armv8 (Arm SystemReady EFI)
# 适用分支: fanchmwrt-25.12.4  (固件版本 1.0.4)
# 产物: 可直接在 QEMU/KVM、Proxmox(ARM)、VMware Fusion(ARM)、
#       Hyper-V(ARM) 等虚拟机中启动的 EFI 磁盘镜像
#
# 用法: 将此文件放到仓库根目录，由 .github/workflows/build-openwrt.yml
#       在 GitHub Actions 云端编译时自动加载 (make defconfig 会补全默认值)。
# ============================================================

# ---- 目标平台 ----
CONFIG_TARGET_armsr=y
CONFIG_TARGET_armsr_armv8=y
CONFIG_TARGET_armsr_armv8_DEVICE_generic=y

# ---- 镜像格式: EFI 合并镜像 (虚拟机最常用) ----
CONFIG_EFI_IMAGES=y
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_VMDK_IMAGES=y                 # 额外生成 VMware .vmdk
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_EXT4FS_JOURNAL=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_KERNEL_PARTSIZE=64
CONFIG_TARGET_ROOTFS_PARTSIZE=5120

# ---- 编译优化: 编译后清理中间产物, 节省磁盘 (GitHub Runner 空间有限) ----
CONFIG_AUTOREMOVE=y

# ---- Web 管理界面 (LuCI) ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# ---- 虚拟机 virtio 驱动 (QEMU/KVM 半虚拟化) ----
CONFIG_PACKAGE_kmod-virtio-net=y
CONFIG_PACKAGE_kmod-virtio-blk=y
CONFIG_PACKAGE_kmod-virtio-rng=y
CONFIG_PACKAGE_kmod-virtio-balloon=y
CONFIG_PACKAGE_kmod-virtio-pci=y
CONFIG_PACKAGE_kmod-virtio-mmio=y

# ---- FanchmWrt 特色功能包 (来自 fanchmwrt feed) ----
CONFIG_PACKAGE_luci-app-fwx-app-center=y
CONFIG_PACKAGE_luci-app-fwx-appfilter=y
CONFIG_PACKAGE_luci-app-fwx-dashboard=y
CONFIG_PACKAGE_luci-app-fwx-dashboard-setting=y
CONFIG_PACKAGE_luci-app-fwx-feature=y
CONFIG_PACKAGE_luci-app-fwx-mac-blacklist=y
CONFIG_PACKAGE_luci-app-fwx-macfilter=y
CONFIG_PACKAGE_luci-app-fwx-network=y
CONFIG_PACKAGE_luci-app-fwx-record=y
CONFIG_PACKAGE_luci-app-fwx-record-whitelist=y
CONFIG_PACKAGE_luci-app-fwx-resources=y
CONFIG_PACKAGE_luci-app-fwx-session-stat=y
CONFIG_PACKAGE_luci-app-fwx-system=y
CONFIG_PACKAGE_luci-app-fwx-traffic-stat=y
CONFIG_PACKAGE_luci-app-fwx-user=y
CONFIG_PACKAGE_luci-app-fwx-user-record=y
CONFIG_PACKAGE_luci-app-fwx-wireless=y

# ---- iStore 应用商店 (来自 linkease/istore feed, 需自定义 feeds.conf 引入) ----
# 老式 Lua LuCI 应用兼容层(istore 依赖 libuci-lua 等)
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_luci-lib-xterm=y
CONFIG_PACKAGE_taskd=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y

# ---- 容器: Docker ----
CONFIG_PACKAGE_luci-app-dockerman=y       # Docker Web 管理
CONFIG_PACKAGE_dockerd=y                  # Docker 引擎
CONFIG_PACKAGE_docker=y                   # Docker CLI

# ---- 容器: LXC ----
CONFIG_PACKAGE_luci-app-lxc=y
CONFIG_PACKAGE_lxc=y
CONFIG_PACKAGE_lxc-auto=y
