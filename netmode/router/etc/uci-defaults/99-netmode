#!/bin/sh
# FanchmWrt 路由模式默认配置 (首次启动自动执行一次后由系统移除)
# 部署形态: 主路由 / 网关
#   - 管理兼内网网关 IP: 192.168.3.1
#   - 开启 LAN 侧 DHCP 服务 (地址池 192.168.3.100~249)
#   - WAN 口保持默认 DHCP 客户端, 由防火墙做 NAT 转发
uci -q batch <<'EOF'
set network.lan.proto='static'
set network.lan.ipaddr='192.168.3.1'
set network.lan.netmask='255.255.255.0'
delete network.lan.gateway
delete network.lan.dns
set dhcp.lan.ignore='0'
set dhcp.lan.start='100'
set dhcp.lan.limit='150'
set dhcp.lan.leasetime='12h'
EOF
uci commit network
uci commit dhcp
exit 0
